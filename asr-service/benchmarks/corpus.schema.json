{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikaru-sub.local/schemas/asr-benchmark-corpus-v1.json",
  "title": "Hikaru Sub ASR Ground-Truth Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "description", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "corpusId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativeKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "audio", "ass", "audioSha256", "assSha256", "durationMs",
        "sampleRate", "channels", "sampleWidthBits", "durationClass", "dialogueCount",
        "tags", "source", "license", "authorizationStatus", "referenceDerivation"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "audio": {"$ref": "#/$defs/relativeKey"},
        "ass": {"$ref": "#/$defs/relativeKey"},
        "audioSha256": {"$ref": "#/$defs/sha256"},
        "assSha256": {"$ref": "#/$defs/sha256"},
        "durationMs": {"type": "integer", "minimum": 1},
        "sampleRate": {"const": 16000},
        "channels": {"const": 1},
        "sampleWidthBits": {"const": 16},
        "durationClass": {"enum": ["short", "medium", "long"]},
        "dialogueCount": {"type": "integer", "minimum": 1},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "authorizationStatus": {"enum": ["redistributable", "private-use-authorized"]},
        "referenceDerivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "speechConfirmation"],
          "properties": {
            "type": {"const": "ass-dialogue-v1"},
            "speechConfirmation": {"const": "confirmed"}
          }
        }
      }
    }
  }
}
