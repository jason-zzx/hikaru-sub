{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 protocol Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-protocol",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON",
        "HIKARU_ASR_BUILD_CT2_WORKER": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-ct2-release",
      "displayName": "Windows x64 CTranslate2 Release",
      "inherits": "windows-x64-release",
      "cacheVariables": {
        "HIKARU_ASR_BUILD_CT2_WORKER": "ON"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-development",
      "displayName": "Windows x64 CTranslate2 CUDA Development",
      "inherits": "windows-x64-ct2-release",
      "binaryDir": "${sourceDir}/../.trellis/tasks/08-04-native-asr-ctranslate2-cuda-development/research/local/build/windows-x64-ct2-cuda",
      "cacheVariables": {
        "HIKARU_ASR_ENABLE_CT2_CUDA_DEVELOPMENT": "ON"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-quality",
      "displayName": "Windows x64 CTranslate2 CUDA Whisper Quality",
      "inherits": "windows-x64-ct2-release",
      "binaryDir": "${sourceDir}/../.trellis/tasks/08-20-native-asr-whisper-quality-revision/research/local/build/windows-x64-ct2-cuda",
      "cacheVariables": {
        "HIKARU_ASR_ENABLE_CT2_CUDA_DEVELOPMENT": "ON",
        "HIKARU_ASR_CT2_PREBUILT_ROOT": "${sourceDir}/../.trellis/tasks/archive/2026-08/08-04-native-asr-ctranslate2-cuda-development/research/local/build/windows-x64-ct2-cuda",
        "HIKARU_ASR_ENABLE_WHISPER_FALLBACK_PARITY": "ON",
        "HIKARU_ASR_ZLIB_ARCHIVE": "${sourceDir}/../.trellis/tasks/08-20-native-asr-whisper-quality-revision/research/local/deps/zlib-1.3.1.tar.gz",
        "HIKARU_ASR_ZLIB_SOURCE_DIR": "${sourceDir}/../.trellis/tasks/08-20-native-asr-whisper-quality-revision/research/local/deps/zlib-1.3.1"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-parity-bisect",
      "displayName": "Windows x64 CTranslate2 CUDA Whisper Short Parity Bisect",
      "inherits": "windows-x64-ct2-cuda-whisper-quality",
      "binaryDir": "${sourceDir}/../.trellis/tasks/08-20-native-asr-whisper-quality-revision/research/local/build/windows-x64-ct2-cuda-short-parity",
      "cacheVariables": {
        "HIKARU_ASR_ENABLE_WHISPER_PARITY_BISECT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-ct2-release",
      "configurePreset": "windows-x64-ct2-release"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-ct2-cuda-development",
      "configurePreset": "windows-x64-ct2-cuda-development"
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-quality",
      "configurePreset": "windows-x64-ct2-cuda-whisper-quality"
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-parity-bisect",
      "configurePreset": "windows-x64-ct2-cuda-whisper-parity-bisect"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-ct2-release",
      "configurePreset": "windows-x64-ct2-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-development",
      "configurePreset": "windows-x64-ct2-cuda-development",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-quality",
      "configurePreset": "windows-x64-ct2-cuda-whisper-quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-ct2-cuda-whisper-parity-bisect",
      "configurePreset": "windows-x64-ct2-cuda-whisper-parity-bisect",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
